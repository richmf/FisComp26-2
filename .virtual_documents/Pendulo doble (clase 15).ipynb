    masa2.set_data([x2[n]],[y2[n]])
    cuerda1.set_data([0,x1[n]],[0,y1[n]])
    cuerda2.set_data([x1[n],x2[n]],[y1[n],y2[n]])
    return fase_m1,fase_m2,masa1,masa2,cuerda1,cuerda2

