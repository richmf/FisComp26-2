fase_m2_2, = ejes[1].plot(th_vth_2[1,0],th_vth_2[3,0])
masa1_1, = ejes[2].plot(pend1[0][0],pend1[1][0],'o',color='purple')
masa2_2, = ejes[2].plot(pend1[2][0],pend1[3][0],'o',color='purple')
