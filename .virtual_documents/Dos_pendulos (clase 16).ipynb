ejes[0].set_xlim([-mfx,mfx]) , ejes[0].set_ylim([-mfy,mfy])
ejes[1].set_xlim([-mfx,mfx]) , ejes[1].set_ylim([-mfy,mfy])
ejes[2].set_xlim([-2.1,2.1]) , ejes[2].set_ylim([-2.1,2.1])
